{
  "name": "asobi",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev:mono": "npm run dev --workspace=@asobi/monoasobi --",
    "dev:loud": "npm run dev --workspace=@asobi/loudasobi --",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate --workspace=@asobi/database",
    "db:migrate": "npm run db:migrate --workspace=@asobi/database",
    "db:studio": "npm run db:studio --workspace=@asobi/database",
    "check:core": "npm run check --workspace=@asobi/content-core"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "typescript": "5.9.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint-plugin-react-hooks": "7.1.1"
  }
}
