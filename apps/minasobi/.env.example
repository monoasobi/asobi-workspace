# 예시이며 실제 값은 Git 제외 .env.local/배포 설정에 둡니다. 운영 구성은 docs/production-environment.md 참고.
TURSO_DATABASE_URL=file:../../.local/development.sqlite
TURSO_AUTH_TOKEN=local-development
ADMIN_PASSWORD=
ADMIN_VIEWER_PASSWORDS=
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_MONOASOBI_URL=http://localhost:3000

# 기존 R2 연결을 사용합니다. 소설/만화 버킷과 공개 앨범아트 버킷은 분리합니다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# 기존 서버 캐시가 있는 Mono에만 무효화 알림을 보냅니다.
# Mono의 REVALIDATION_SECRET과 짝을 맞춥니다.
MONOASOBI_URL=http://localhost:3000
MONOASOBI_REVALIDATION_SECRET=
# 아래 주소는 로컬 HTTP 검사에만 사용하며 Loud 캐시 알림은 보내지 않습니다.
LOUDASOBI_URL=http://localhost:3001

# 독립 앨범아트: 전용 버킷/도메인 검증 후 세 앱에 동일하게 설정합니다.
# 연결 검증 완료: https://assets.envifloor.uk (공개 커버 전용)
NEXT_PUBLIC_ASSET_BASE_URL=https://assets.envifloor.uk
# 해당 zone의 Images Free 변환을 활성화하고 다섯 크기를 검증했습니다.
NEXT_PUBLIC_ASSET_TRANSFORMS=true

# server-only: 공개 앨범아트만 담을 분리된 버킷. 기존 R2_BUCKET_NAME은 비공개 콘텐츠용.
# 사용자 승인된 앨범아트 대상이며 환경별 별도 버킷은 요구하지 않습니다.
R2_ALBUM_ART_BUCKET_NAME=asobi-album-art
