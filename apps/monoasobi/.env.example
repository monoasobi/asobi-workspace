R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_END_POINT=

PRIVATE_READER_PASSWORD=
PRIVATE_READER_SESSION_SECRET=

ADMIN_PASSWORD=
ADMIN_VIEWER_PASSWORDS=
ADMIN_SESSION_SECRET=
AGENT_API_TOKEN=

# 각 앱 디렉터리 기준 같은 로컬 SQLite 파일을 사용합니다.
# 운영 환경은 해당 배포의 서버 전용 설정으로 별도 관리합니다.
TURSO_DATABASE_URL=file:../../.local/development.sqlite
# LOUDASOBI getDb의 필수값 검사와 호환되는 로컬 전용 표식입니다.
TURSO_AUTH_TOKEN=local-development

# 관리자 서버의 공개 카탈로그 갱신 알림용 별도 비밀값
REVALIDATION_SECRET=

# 독립 앨범아트: 전용 버킷/도메인 검증 후 세 앱에 동일하게 설정합니다.
# 연결 검증 완료: https://assets.envifloor.uk (공개 커버 전용)
NEXT_PUBLIC_ASSET_BASE_URL=https://assets.envifloor.uk
# 해당 zone의 Images Free 변환을 활성화하고 다섯 크기를 검증했습니다.
NEXT_PUBLIC_ASSET_TRANSFORMS=true

# server-only: 공개 앨범아트만 담을 분리된 버킷. 기존 R2_BUCKET_NAME은 비공개 콘텐츠용.
# 운영 전환 대상은 asobi-album-art입니다. 개발 쓰기는 별도 검증 버킷을 지정하세요.
R2_ALBUM_ART_BUCKET_NAME=
