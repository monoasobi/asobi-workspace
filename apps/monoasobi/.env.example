# 각 앱 디렉터리 기준 같은 로컬 SQLite 파일을 사용합니다.
# 운영 환경은 해당 배포의 서버 전용 설정으로 별도 관리합니다.
TURSO_DATABASE_URL=file:../../.local/development.sqlite
# LOUDASOBI getDb의 필수값 검사와 호환되는 로컬 전용 표식입니다.
TURSO_AUTH_TOKEN=local-development
